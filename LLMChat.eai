// Local-only; enabled after melee AI startup or by -llm on.
// Unique incoming filenames avoid caching a previous preload script.
function LLMChatText takes nothing returns string
    if llmForwardedChat != "" then
        return llmForwardedChat
    endif
    return GetEventPlayerChatString()
endfunction

function LLMEncode takes string s returns string
    local integer i = 0
    local string c
    local string result = ""
    loop
        exitwhen i >= StringLength(s)
        set c = SubString(s, i, i + 1)
        if c == "%" then
            set result = result + "%25"
        elseif c == "|" then
            set result = result + "%7C"
        elseif c == "\"" then
            set result = result + "%22"
        elseif c == "\\" then
            set result = result + "%5C"
        elseif c == "\n" then
            set result = result + "%0A"
        elseif c == "\r" then
            set result = result + "%0D"
        else
            set result = result + c
        endif
        set i = i + 1
    endloop
    return result
endfunction

function LLMRecord takes string kind, integer bot, integer unitType, string unitName, integer level, integer owner, integer killer, string text, string extra returns nothing
    set llmSeq = llmSeq + 1
    set llmRecordKinds[ModuloInteger(llmSeq, 256)] = kind
    set llmRecords[ModuloInteger(llmSeq, 256)] = "AMAI1|" + llmSession + "|" + I2S(llmSeq) + "|" + R2S(TimerGetElapsed(llmClock)) + "|" + kind + "|" + I2S(bot) + "|" + I2S(llmHuman) + "|" + I2S(unitType) + "|" + LLMEncode(unitName) + "|" + I2S(level) + "|" + I2S(owner) + "|" + I2S(killer) + "|" + LLMEncode(text) + "|" + LLMEncode(extra)
endfunction

function LLMResetTelemetry takes nothing returns nothing
    local integer i = 0
    if llmCache != null then
        call FlushParentHashtable(llmCache)
    endif
    set llmCache = InitHashtable()
    set llmSampleCursor = 0
    loop
        exitwhen i >= GetBJMaxPlayers()
        set llmSampleDue[i] = 0
        set llmMapSiteDue[i] = 0
        set i = i + 1
    endloop
endfunction

function LLMField takes string s, integer field returns string
    local integer i = 0
    local integer start = 0
    local integer current = 0
    loop
        exitwhen i >= StringLength(s)
        if SubString(s, i, i + 1) == "|" then
            if current == field then
                return SubString(s, start, i)
            endif
            set current = current + 1
            set start = i + 1
        endif
        set i = i + 1
    endloop
    if current == field then
        return SubString(s, start, i)
    endif
    return ""
endfunction

function LLMColor takes player p returns string
    local playercolor c = GetPlayerColor(p)
    if c == PLAYER_COLOR_RED then
        return "ff0303"
    elseif c == PLAYER_COLOR_BLUE then
        return "0042ff"
    elseif c == PLAYER_COLOR_CYAN then
        return "1ce6b9"
    elseif c == PLAYER_COLOR_PURPLE then
        return "540081"
    elseif c == PLAYER_COLOR_YELLOW then
        return "fffc01"
    elseif c == PLAYER_COLOR_ORANGE then
        return "fe8a0e"
    elseif c == PLAYER_COLOR_GREEN then
        return "20c000"
    elseif c == PLAYER_COLOR_PINK then
        return "e55bb0"
    elseif c == PLAYER_COLOR_LIGHT_GRAY then
        return "959697"
    elseif c == PLAYER_COLOR_LIGHT_BLUE then
        return "7ebff1"
    elseif c == PLAYER_COLOR_AQUA then
        return "106246"
    elseif c == PLAYER_COLOR_BROWN then
        return "4e2a04"
    endif
    return "ffcc00"
endfunction

function LLMJournal takes player sender, string channel, string text returns nothing
    local integer seconds = ModuloInteger(R2I(TimerGetElapsed(llmClock)), 60)
    local string stamp = I2S(R2I(TimerGetElapsed(llmClock) / 60.0)) + ":"
    local string label = "[CHAT]"
    if GetPlayerId(GetLocalPlayer()) != llmHuman or text == "" then
        return
    endif
    if seconds < 10 then
        set stamp = stamp + "0"
    endif
    set stamp = stamp + I2S(seconds)
    if channel == "all" then
        set label = "[ALL]"
    elseif channel == "team" then
        set label = "[TEAM]"
    endif
    if StringCase(SubString(text, 0, 5), false) == "@all " then
        set text = SubString(text, 5, StringLength(text))
    elseif StringCase(SubString(text, 0, 6), false) == "@team " then
        set text = SubString(text, 6, StringLength(text))
    endif
    // Trigger text is retained by F12 after its screen lifetime expires.
    // Zero duration remains on screen in 3.0.1; use a positive sub-frame TTL.
    call DisplayTimedTextToPlayer(Player(llmHuman), 0, 0, 0.01, "[" + stamp + "] " + label + " |cff" + LLMColor(sender) + GetPlayerName(sender) + "|r: " + text)
endfunction



function LLMAllies takes integer bot returns string
    local integer i = 0
    local string result = "allies:"
    loop
        exitwhen i >= GetBJMaxPlayers()
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and (i == bot or (IsPlayerAlly(Player(bot), Player(i)) and IsPlayerAlly(Player(i), Player(bot)))) then
            if result != "allies:" then
                set result = result + ","
            endif
            set result = result + I2S(i)
        endif
        set i = i + 1
    endloop
    return result
endfunction

function LLMObserve takes string kind, unit u, integer value, string text, string extra, boolean alliedOnly returns nothing
    local integer i = 0
    local integer owner
    if not llmActive or u == null then
        return
    endif
    set owner = GetPlayerId(GetOwningPlayer(u))
    loop
        exitwhen i >= GetBJMaxPlayers()
        if GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then
            if owner == i or (not alliedOnly and IsUnitVisible(u, Player(i)) and not IsUnitInvisible(u, Player(i)) and not IsUnitHidden(u)) then
                call LLMRecord(kind, i, GetUnitTypeId(u), GetUnitName(u), value, owner, -1, text, extra + ";unit=" + I2S(GetHandleId(u)))
            endif
        endif
        set i = i + 1
    endloop
endfunction

function LLMInventory takes unit u returns string
    local integer i = 0
    local item it
    local string result = ""
    loop
        exitwhen i >= 6
        set it = UnitItemInSlot(u, i)
        if i > 0 then
            set result = result + "; "
        endif
        set result = result + I2S(i + 1) + ":"
        if it != null then
            set result = result + GetItemName(it) + " [" + I2S(GetItemTypeId(it)) + ",charges=" + I2S(GetItemCharges(it)) + "]"
        else
            set result = result + "empty"
        endif
        set i = i + 1
    endloop
    set it = null
    return result
endfunction

function LLMAbilities takes unit u returns string
    local integer i = 0
    local integer id
    local ability a
    local string result = ""
    loop
        exitwhen i >= 64
        set a = BlzGetUnitAbilityByIndex(u, i)
        exitwhen a == null
        set id = BlzGetAbilityId(a)
        if BlzGetAbilityBooleanField(a, ABILITY_BF_HERO_ABILITY) and GetUnitAbilityLevel(u, id) > 0 then
            set result = result + GetObjectName(id) + " [" + I2S(id) + ",level=" + I2S(GetUnitAbilityLevel(u, id)) + "]; "
        endif
        set i = i + 1
    endloop
    set a = null
    return result
endfunction

// Own roster only: the planner can request a real unit type without inspecting opponents.
function LLMOwnForces takes integer bot returns nothing
    local group g = CreateGroup()
    local unit u
    local integer id
    local integer n = 0
    local integer i = 0
    local integer order
    local integer array types
    local string current
    // Clear only the scratch partitions, retaining the usable table itself.
    call FlushChildHashtable(llmForceCache, 0)
    call FlushChildHashtable(llmForceCache, 1)
    call FlushChildHashtable(llmForceCache, 2)
    call GroupEnumUnitsOfPlayer(g, Player(bot), null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitType(u, UNIT_TYPE_DEAD) and GetUnitTypeId(u) != 0 then
            set id = GetUnitTypeId(u)
            if not HaveSavedInteger(llmForceCache, 0, id) and n < 40 then
                set types[n] = id
                set n = n + 1
                call SaveStr(llmForceCache, 2, id, GetUnitName(u))
            endif
            call SaveInteger(llmForceCache, 0, id, LoadInteger(llmForceCache, 0, id) + 1)
            set order = GetUnitCurrentOrder(u)
            if order == OrderId("harvest") or order == OrderId("resumeharvesting") or order == OrderId("returnresources") then
                call SaveInteger(llmForceCache, 1, id, LoadInteger(llmForceCache, 1, id) + 1)
            endif
        endif
    endloop
    loop
        exitwhen i >= n
        set id = types[i]
        set current = "count=" + I2S(LoadInteger(llmForceCache, 0, id)) + ";working=" + I2S(LoadInteger(llmForceCache, 1, id))
        if LoadStr(llmCache, -(bot + 1), id) != current or TimerGetElapsed(llmClock) - LoadReal(llmCache, -(bot + 1), -id) >= 10 then
            call LLMRecord("own-forces", bot, id, LoadStr(llmForceCache, 2, id), 0, bot, -1, "own unit roster", current)
            call SaveStr(llmCache, -(bot + 1), id, current)
            call SaveReal(llmCache, -(bot + 1), -id, TimerGetElapsed(llmClock))
        endif
        set i = i + 1
    endloop
    call DestroyGroup(g)
    set g = null
    set u = null
endfunction

function LLMSample takes integer owner returns nothing
    local group heroes = CreateGroup()
    local unit u
    local integer bot
    local integer key
    local real x
    local real y
    local real dx
    local real dy
    local string inventory
    local string skills
    local string refresh
    local integer army
    local integer sightings
    local integer site
    local integer explored
    local real life
    local real maxlife
    local real homex
    local real homey
    if GetPlayerSlotState(Player(owner)) == PLAYER_SLOT_STATE_PLAYING then
        set army = 0
        set life = 0
        set maxlife = 0
        set sightings = 0
        set homex = GetStartLocationX(GetPlayerStartLocation(Player(owner)))
        set homey = GetStartLocationY(GetPlayerStartLocation(Player(owner)))
        call GroupEnumUnitsOfPlayer(heroes, Player(owner), null)
        loop
            set u = FirstOfGroup(heroes)
            exitwhen u == null
            call GroupRemoveUnit(heroes, u)
            if GetPlayerController(Player(owner)) == MAP_CONTROL_COMPUTER and not IsUnitType(u, UNIT_TYPE_PEON) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitType(u, UNIT_TYPE_DEAD) then
                set army = army + 1
                set life = life + GetWidgetLife(u)
                set maxlife = maxlife + GetUnitState(u, UNIT_STATE_MAX_LIFE)
            endif
            if GetPlayerController(Player(owner)) == MAP_CONTROL_COMPUTER and IsUnitType(u, UNIT_TYPE_TOWNHALL) and not IsUnitType(u, UNIT_TYPE_DEAD) then
                set homex = GetUnitX(u)
                set homey = GetUnitY(u)
            endif
            if (IsUnitType(u, UNIT_TYPE_HERO) or (IsUnitType(u, UNIT_TYPE_STRUCTURE) and sightings < 12)) and GetUnitTypeId(u) != 0 and not IsUnitType(u, UNIT_TYPE_DEAD) then
                set sightings = sightings + 1
                set key = GetHandleId(u)
                set x = GetUnitX(u)
                set y = GetUnitY(u)
                set inventory = ""

                set bot = 0
                loop
                    exitwhen bot >= GetBJMaxPlayers()
                    if GetPlayerController(Player(bot)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(bot)) == PLAYER_SLOT_STATE_PLAYING and (owner == bot or (IsUnitVisible(u, Player(bot)) and not IsUnitInvisible(u, Player(bot)) and not IsUnitHidden(u))) then
                        set dx = x - LoadReal(llmCache, key, bot * 16 + 8)
                        set dy = y - LoadReal(llmCache, key, bot * 16 + 9)
                        if not HaveSavedReal(llmCache, key, bot * 16 + 5) or dx * dx + dy * dy >= 409600 or TimerGetElapsed(llmClock) - LoadReal(llmCache, key, bot * 16 + 5) >= 10 then
                            call LLMRecord("sighting", bot, GetUnitTypeId(u), GetUnitName(u), 0, owner, -1, "observed", "x=" + R2S(x) + ";y=" + R2S(y) + ";unit=" + I2S(key) + ";observed=1")
                            call SaveReal(llmCache, key, bot * 16 + 5, TimerGetElapsed(llmClock))
                            call SaveReal(llmCache, key, bot * 16 + 8, x)
                            call SaveReal(llmCache, key, bot * 16 + 9, y)
                        endif
                        if IsUnitType(u, UNIT_TYPE_HERO) then
                            if inventory == "" then
                                set inventory = LLMInventory(u)
                            endif
                            set dx = x - LoadReal(llmCache, key, bot * 16 + 1)
                            set dy = y - LoadReal(llmCache, key, bot * 16 + 2)
                            if not HaveSavedReal(llmCache, key, bot * 16 + 1) or dx * dx + dy * dy >= 409600 or TimerGetElapsed(llmClock) - LoadReal(llmCache, key, bot * 16) >= 15 then
                                call LLMRecord("position", bot, GetUnitTypeId(u), GetUnitName(u), GetHeroLevel(u), owner, -1, GetHeroProperName(u), "x=" + R2S(x) + ";y=" + R2S(y) + ";unit=" + I2S(key))
                                call SaveReal(llmCache, key, bot * 16 + 1, x)
                                call SaveReal(llmCache, key, bot * 16 + 2, y)
                                call SaveReal(llmCache, key, bot * 16, TimerGetElapsed(llmClock))
                            endif
                            if LoadStr(llmCache, key, bot * 16 + 3) != inventory or TimerGetElapsed(llmClock) - LoadReal(llmCache, key, bot * 16 + 6) >= 60 then
                                set refresh = "false"
                                if LoadStr(llmCache, key, bot * 16 + 3) == inventory then
                                    set refresh = "true"
                                endif
                                call LLMRecord("inventory", bot, GetUnitTypeId(u), GetUnitName(u), GetHeroLevel(u), owner, -1, inventory, "unit=" + I2S(key) + ";proper=" + GetHeroProperName(u) + ";refresh=" + refresh)
                                call SaveStr(llmCache, key, bot * 16 + 3, inventory)
                                call SaveReal(llmCache, key, bot * 16 + 6, TimerGetElapsed(llmClock))
                            endif
                            if owner == bot then
                                set skills = LLMAbilities(u)
                                if LoadStr(llmCache, key, bot * 16 + 4) != skills or TimerGetElapsed(llmClock) - LoadReal(llmCache, key, bot * 16 + 7) >= 60 then
                                    call LLMRecord("abilities", bot, GetUnitTypeId(u), GetUnitName(u), GetHeroLevel(u), owner, -1, skills, "unit=" + I2S(key) + ";proper=" + GetHeroProperName(u))
                                    call SaveStr(llmCache, key, bot * 16 + 4, skills)
                                    call SaveReal(llmCache, key, bot * 16 + 7, TimerGetElapsed(llmClock))
                                endif
                            endif
                        endif
                    endif
                    set bot = bot + 1
                endloop
            endif
        endloop
    endif
    if GetPlayerController(Player(owner)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(owner)) == PLAYER_SLOT_STATE_PLAYING then
        if maxlife < 1 then
            set maxlife = 1
        endif
        call LLMRecord("self-state", owner, 0, "own home/state", 0, owner, -1, "private", "x=" + R2S(homex) + ";y=" + R2S(homey) + ";army=" + I2S(army) + ";health=" + R2S(life / maxlife) + ";gold=" + I2S(GetPlayerState(Player(owner), PLAYER_STATE_RESOURCE_GOLD)) + ";lumber=" + I2S(GetPlayerState(Player(owner), PLAYER_STATE_RESOURCE_LUMBER)) + ";unit=0")
    endif
    if GetPlayerController(Player(owner)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(owner)) == PLAYER_SLOT_STATE_PLAYING then
        call LLMOwnForces(owner)
        if TimerGetElapsed(llmClock) >= llmMapSiteDue[owner] then
            set llmMapSiteDue[owner] = TimerGetElapsed(llmClock) + 60
            set site = 0
            loop
                exitwhen site >= GetPlayers()
                set x = GetStartLocationX(site)
                set y = GetStartLocationY(site)
                set explored = 0
                if not IsMaskedToPlayer(x, y, Player(owner)) then
                    set explored = 1
                endif
                call LLMRecord("map-site", owner, site, "public map start site", 0, 27, -1, "occupancy unknown", "x=" + R2S(x) + ";y=" + R2S(y) + ";site=" + I2S(site) + ";explored=" + I2S(explored))
                set site = site + 1
            endloop
        endif
    endif
    call DestroyGroup(heroes)
    set heroes = null
    set u = null
endfunction

// One owner per transport tick, with a five-second minimum revisit interval.
function LLMSampleStep takes nothing returns nothing
    local integer checked = 0
    local integer owner
    loop
        exitwhen checked >= GetBJMaxPlayers()
        set owner = llmSampleCursor
        set llmSampleCursor = ModuloInteger(llmSampleCursor + 1, GetBJMaxPlayers())
        if GetPlayerSlotState(Player(owner)) == PLAYER_SLOT_STATE_PLAYING and TimerGetElapsed(llmClock) >= llmSampleDue[owner] then
            set llmSampleDue[owner] = TimerGetElapsed(llmClock) + 5
            call LLMSample(owner)
            return
        endif
        set checked = checked + 1
    endloop
endfunction

function LLMOnTelemetry takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local item it = null
    local eventid ev = GetTriggerEventId()
    local string kind = ""
    local string text = ""
    local string extra = ""
    local integer value = 0
    local boolean alliedOnly = false
    if not llmActive then
        set u = null
        return
    endif
    if ev == EVENT_PLAYER_UNIT_CONSTRUCT_START then
        set u = GetConstructingStructure()
        set kind = "build-start"
    elseif ev == EVENT_PLAYER_UNIT_CONSTRUCT_FINISH then
        set u = GetConstructedStructure()
        set kind = "build-finish"
    elseif ev == EVENT_PLAYER_UNIT_CONSTRUCT_CANCEL then
        set u = GetCancelledStructure()
        set kind = "build-cancel"
    elseif ev == EVENT_PLAYER_UNIT_UPGRADE_START then
        set kind = "upgrade-start"
    elseif ev == EVENT_PLAYER_UNIT_UPGRADE_FINISH then
        set kind = "upgrade-finish"
    elseif ev == EVENT_PLAYER_UNIT_UPGRADE_CANCEL then
        set kind = "upgrade-cancel"
    elseif ev == EVENT_PLAYER_UNIT_RESEARCH_FINISH then
        set kind = "research"
        set text = GetObjectName(GetResearched())
        set extra = "id=" + I2S(GetResearched())
        set alliedOnly = true
    elseif ev == EVENT_PLAYER_HERO_LEVEL then
        set kind = "level"
        set value = GetHeroLevel(u)
    elseif ev == EVENT_PLAYER_HERO_SKILL then
        set kind = "skill"
        set value = GetLearnedSkillLevel()
        set text = GetObjectName(GetLearnedSkill())
        set extra = "ability=" + I2S(GetLearnedSkill())
        set alliedOnly = true
    elseif ev == EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER then
        if not IsUnitType(u, UNIT_TYPE_HERO) or TimerGetElapsed(llmClock) - LoadReal(llmCache, GetHandleId(u), 1000) < 4 then
            set u = null
            return
        endif
        call SaveReal(llmCache, GetHandleId(u), 1000, TimerGetElapsed(llmClock))
        set kind = "move"
        set text = OrderId2String(GetIssuedOrderId())
        set extra = "x=" + R2S(GetOrderPointX()) + ";y=" + R2S(GetOrderPointY()) + ";order=" + I2S(GetIssuedOrderId())
        set alliedOnly = true
    elseif ev == EVENT_PLAYER_UNIT_PICKUP_ITEM then
        set kind = "item-pickup"
        set it = GetManipulatedItem()
    elseif ev == EVENT_PLAYER_UNIT_DROP_ITEM then
        set kind = "item-drop"
        set it = GetManipulatedItem()
    elseif ev == EVENT_PLAYER_UNIT_USE_ITEM then
        set kind = "item-use"
        set it = GetManipulatedItem()
    elseif ev == EVENT_PLAYER_UNIT_SELL_ITEM then
        set kind = "item-buy"
        set u = GetBuyingUnit()
        set it = GetSoldItem()
    elseif ev == EVENT_PLAYER_UNIT_PAWN_ITEM then
        set kind = "item-sell"
        set u = GetTriggerUnit()
        set it = GetManipulatedItem()
    endif
    if it != null then
        set text = GetItemName(it)
        set extra = "item=" + I2S(GetItemTypeId(it)) + ";charges=" + I2S(GetItemCharges(it))
    endif
    if kind != "" and u != null then
        if extra == "" then
            set extra = "x=" + R2S(GetUnitX(u)) + ";y=" + R2S(GetUnitY(u))
        endif
        call LLMObserve(kind, u, value, text, extra, alliedOnly)
    endif
    set it = null
    set u = null
endfunction

function LLMActionPoll takes nothing returns nothing
    local integer bot
    local integer id
    local integer action
    local integer source
    local integer owner
    local integer status
    local integer requestedType
    local real cooperation
    local real x
    local real y
    local real expires
    local string original = BlzGetAbilityTooltip('Amls', 0)
    local string incoming
    local string key
    local string label
    call StoreReal(llmActionCache, "clock", "now", TimerGetElapsed(llmClock))
    call BlzSetAbilityTooltip('Amls', "", 0)
    call Preloader("AMAI-LLM\\action-" + llmSession + "-" + I2S(llmTick) + ".pld")
    set incoming = BlzGetAbilityTooltip('Amls', 0)
    call BlzSetAbilityTooltip('Amls', original, 0)
    if LLMField(incoming, 0) == llmSession and S2I(LLMField(incoming, 1)) == llmTick and TimerGetElapsed(llmClock) <= S2R(LLMField(incoming, 3)) then
        set bot = S2I(LLMField(incoming, 2))
        set id = S2I(LLMField(incoming, 4))
        set action = S2I(LLMField(incoming, 5))
        set x = S2R(LLMField(incoming, 6))
        set y = S2R(LLMField(incoming, 7))
        set source = S2I(LLMField(incoming, 8))
        set owner = S2I(LLMField(incoming, 9))
        set expires = S2R(LLMField(incoming, 11))
        set cooperation = S2R(LLMField(incoming, 12))
        set requestedType = S2I(LLMField(incoming, 13))
        if bot >= 0 and bot < GetBJMaxPlayers() and source >= 0 and source < GetBJMaxPlayers() and owner >= 0 and owner < 28 and id > 0 and action >= 1 and action <= 6 and x >= -32768 and x <= 32768 and y >= -32768 and y <= 32768 and expires > TimerGetElapsed(llmClock) and expires <= TimerGetElapsed(llmClock) + 95 then
            if GetPlayerController(Player(bot)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(bot)) == PLAYER_SLOT_STATE_PLAYING then
                set key = I2S(bot)
                if id > GetStoredInteger(llmActionCache, key, "id") then
                    call StoreInteger(llmActionCache, key, "action", action)
                    call StoreInteger(llmActionCache, key, "source", source)
                    call StoreInteger(llmActionCache, key, "owner", owner)
                    call StoreReal(llmActionCache, key, "x", x)
                    call StoreReal(llmActionCache, key, "y", y)
                    call StoreReal(llmActionCache, key, "observed", S2R(LLMField(incoming, 10)))
                    call StoreReal(llmActionCache, key, "expires", expires)
                    call StoreReal(llmActionCache, key, "cooperation", cooperation)
                    call StoreInteger(llmActionCache, key, "unit-type", requestedType)
                    call StoreInteger(llmActionCache, key, "id", id)
                    call CommandAI(Player(bot), 95, id)
                endif
            endif
        endif
    endif
    set bot = 0
    loop
        exitwhen bot >= GetBJMaxPlayers()
        set key = I2S(bot)
        set id = GetStoredInteger(llmActionCache, key, "out-id")
        set status = GetStoredInteger(llmActionCache, key, "out-status")
        if id > 0 and (llmActionId[bot] != id or llmActionStatus[bot] != status) then
            set label = "rejected"
            if status == 1 then
                set label = "accepted"
            elseif status == 2 then
                set label = "running"
            elseif status == 3 then
                set label = "completed"
            elseif status == 5 then
                set label = "cancelled"
            elseif status == 6 then
                set label = "expired"
            endif
            call LLMRecord("action-status", bot, 0, "", 0, bot, -1, label, "id=" + I2S(id) + ";status=" + label + ";reason=" + GetStoredString(llmActionCache, key, "out-reason"))
            set llmActionId[bot] = id
            set llmActionStatus[bot] = status
        endif
        set bot = bot + 1
    endloop
endfunction


// Native single-player chat does not expose its actual channel. Capture the
// opening key instead; the choice belongs to this input, not the submit key.
function LLMInputReady takes nothing returns boolean
    local framehandle f = BlzGetFrameByName("UpperButtonBarMenuButton", 0)
    if not llmActive or llmHuman < 0 or GetPlayerId(GetLocalPlayer()) != llmHuman or not BlzIsLocalClientActive() then
        return false
    endif
    if f == null or not BlzFrameGetEnable(f) then
        return false
    endif
    set f = BlzGetFrameByName("AllianceDialog", 0)
    if f != null and BlzFrameIsVisible(f) then
        return false
    endif
    set f = BlzGetFrameByName("LogDialog", 0)
    if f != null and BlzFrameIsVisible(f) then
        return false
    endif
    set f = BlzGetFrameByName("QuestDialog", 0)
    if f != null and BlzFrameIsVisible(f) then
        return false
    endif
    set f = BlzGetFrameByName("EscMenuBackdrop", 0)
    if f != null and BlzFrameIsVisible(f) then
        return false
    endif
    set f = null
    return true
endfunction

function LLMInputHasAlly takes nothing returns boolean
    local integer i = 0
    loop
        exitwhen i >= GetBJMaxPlayers()
        if GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and IsPlayerAlly(Player(i), Player(llmHuman)) and IsPlayerAlly(Player(llmHuman), Player(i)) then
            return true
        endif
        set i = i + 1
    endloop
    return false
endfunction

function LLMInputCancel takes nothing returns nothing
    set llmInputOpen = false
    set llmInputChoice = ""
    set llmComposerActive = false
    if llmInputBox != null then
        call BlzFrameSetFocus(llmInputBox, false)
        call BlzFrameSetVisible(llmInputBox, false)
    endif
    if llmInputBackdrop != null then
        call BlzFrameSetVisible(llmInputBackdrop, false)
    endif
    if llmInputLabel != null then
        call BlzFrameSetVisible(llmInputLabel, false)
    endif
endfunction

function LLMInputFinish takes nothing returns nothing
    call LLMInputCancel()
    set llmInputSubmittedAt = TimerGetElapsed(llmClock)
    set llmEnterDown = BlzIsKeyPressed(OSKEY_RETURN)
endfunction

// Opening and immediately cancelling the menu dismisses the built-in input.
// Defer this until the engine has finished handling the opening/submit key.
function LLMInputCloseNative takes nothing returns nothing
    local framehandle menu = BlzGetFrameByName("UpperButtonBarMenuButton", 0)
    if menu != null and BlzFrameGetEnable(menu) then
        call BlzFrameClick(menu)
        call ForceUICancel()
    endif
    set menu = null
endfunction

function LLMInputPresent takes nothing returns nothing
    if not llmActive or not llmInputOpen or llmInputBox == null then
        return
    endif
    call LLMInputCloseNative()
    if not LLMInputReady() then
        call LLMInputCancel()
        return
    endif
    call BlzFrameSetText(llmInputBox, "")
    call BlzFrameSetVisible(llmInputBackdrop, true)
    call BlzFrameSetVisible(llmInputLabel, true)
    call BlzFrameSetVisible(llmInputBox, true)
    set llmComposerActive = true
    call BlzFrameSetFocus(llmInputBox, true)
endfunction

function LLMInputSelect takes boolean publicChat returns nothing
    if llmInputOpen or not LLMInputReady() or TimerGetElapsed(llmClock) - llmInputSubmittedAt < 0.25 then
        return
    endif
    set llmInputChoice = "team"
    if publicChat or not LLMInputHasAlly() then
        set llmInputChoice = "all"
    endif
    set llmInputOpen = true
    set llmInputOpenedAt = TimerGetElapsed(llmClock)
    if llmInputLabel != null then
        if llmInputChoice == "all" then
            call BlzFrameSetText(llmInputLabel, "|cffffcc00AMAI > ALL|r")
        else
            call BlzFrameSetText(llmInputLabel, "|cff66ddaaAMAI > TEAM|r")
        endif
        call BlzFrameSetVisible(llmInputLabel, true)
    endif
    call TimerStart(llmInputPresentationTimer, 0.0, false, function LLMInputPresent)
endfunction

function LLMOnChatKey takes nothing returns nothing
    if not llmActive or GetPlayerId(GetTriggerPlayer()) != llmHuman then
        return
    endif
    if BlzGetTriggerPlayerKey() == OSKEY_ESCAPE then
        call LLMInputCancel()
    elseif BlzGetTriggerPlayerKey() == OSKEY_RETURN then
        set llmEnterDown = true
        call LLMInputSelect(ModuloInteger(BlzGetTriggerPlayerMetaKey(), 2) == 1)
    endif
endfunction

function LLMInputUpdate takes nothing returns nothing
    local boolean down = BlzIsKeyPressed(OSKEY_RETURN)
    if not llmActive then
        return
    endif
    // Also sample key edges: native chat takes keyboard focus and can suppress
    // key triggers, including Escape. Do not change routes while composing.
    if llmInputOpen then
        if BlzIsKeyPressed(OSKEY_ESCAPE) or not LLMInputReady() then
            call LLMInputCancel()
        endif
    elseif down and not llmEnterDown then
        call LLMInputSelect(BlzIsKeyPressed(OSKEY_LSHIFT) or BlzIsKeyPressed(OSKEY_RSHIFT))
    endif
    set llmEnterDown = down
endfunction

function LLMInputStart takes nothing returns nothing
    if llmInputLabel == null then
        set llmInputBackdrop = BlzCreateFrameByType("BACKDROP", "AMAIChatBackdrop", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
        call BlzFrameSetAbsPoint(llmInputBackdrop, FRAMEPOINT_CENTER, 0.4, 0.20)
        call BlzFrameSetSize(llmInputBackdrop, 0.59, 0.034)
        call BlzFrameSetTexture(llmInputBackdrop, "UI\\Widgets\\ToolTips\\Human\\human-tooltip-background.blp", 0, true)
        call BlzFrameSetEnable(llmInputBackdrop, false)
        set llmInputLabel = BlzCreateFrameByType("TEXT", "AMAIChatRoute", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
        call BlzFrameSetAbsPoint(llmInputLabel, FRAMEPOINT_LEFT, 0.115, 0.20)
        call BlzFrameSetSize(llmInputLabel, 0.105, 0.022)
        call BlzFrameSetFont(llmInputLabel, "Fonts\\FRIZQT__.TTF", 0.012, 0)
        call BlzFrameSetEnable(llmInputLabel, false)
        set llmInputBox = BlzCreateFrameByType("EDITBOX", "AMAIChatInput", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
        call BlzFrameSetAbsPoint(llmInputBox, FRAMEPOINT_LEFT, 0.225, 0.20)
        call BlzFrameSetSize(llmInputBox, 0.455, 0.026)
        call BlzFrameSetFont(llmInputBox, "Fonts\\FRIZQT__.TTF", 0.013, 0)
        call BlzFrameSetTextColor(llmInputBox, BlzConvertColor(255, 255, 255, 255))
        // Frame input events carry at most 255 bytes. 120 Cyrillic characters
        // fit in that transport; keep the editor bounded as well as bot output.
        call BlzFrameSetTextSizeLimit(llmInputBox, 120)
        call BlzTriggerRegisterFrameEvent(llmInputSubmitTrigger, llmInputBox, FRAMEEVENT_EDITBOX_ENTER)
    endif
    call LLMInputCancel()
    set llmEnterDown = BlzIsKeyPressed(OSKEY_RETURN)
    call TimerStart(llmInputTimer, 0.05, true, function LLMInputUpdate)
endfunction

// Single-player disables this native button even with computer allies. Restore
// it alongside the normal menu, without changing alliances or chat handlers.
function LLMEnableAlliesMenu takes nothing returns nothing
    local framehandle menu = BlzGetFrameByName("UpperButtonBarMenuButton", 0)
    local framehandle allies = BlzGetFrameByName("UpperButtonBarAlliesButton", 0)
    local integer i = 0
    if menu == null or allies == null then
        return
    endif
    if not BlzFrameGetEnable(menu) or BlzFrameGetEnable(allies) then
        return
    endif
    loop
        exitwhen i >= GetBJMaxPlayers()
        if GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and IsPlayerAlly(Player(i), Player(llmHuman)) and IsPlayerAlly(Player(llmHuman), Player(i)) then
            call BlzFrameSetEnable(allies, true)
            exitwhen true
        endif
        set i = i + 1
    endloop
    set menu = null
    set allies = null
endfunction

function LLMExportImportant takes string kind returns boolean
    return kind == "chat" or kind == "death" or kind == "revive" or kind == "skill" or kind == "research" or kind == "action-status" or kind == "hello"
endfunction

function LLMPoll takes nothing returns nothing
    local integer first
    local integer i
    local integer seq
    local integer eventSeq
    local integer bot
    local integer recipient
    local string original
    local string incoming
    local string text
    local string channel
    local integer chatMode
    local integer retained = 0
    local integer importantFrom
    if not llmActive then
        return
    endif
    call LLMEnableAlliesMenu()
    set llmTick = llmTick + 1
    call LLMActionPoll()
    set original = BlzGetAbilityTooltip('Amls', 0)
    call BlzSetAbilityTooltip('Amls', "", 0)
    call Preloader("AMAI-LLM\\reply-" + llmSession + "-" + I2S(llmTick) + ".pld")
    set incoming = BlzGetAbilityTooltip('Amls', 0)
    call BlzSetAbilityTooltip('Amls', original, 0)
    if LLMField(incoming, 0) == llmSession then
        set seq = S2I(LLMField(incoming, 1))
        set eventSeq = S2I(LLMField(incoming, 5))
        set bot = S2I(LLMField(incoming, 2))
        set text = LLMField(incoming, 4)
        set channel = LLMField(incoming, 6)
        set recipient = S2I(LLMField(incoming, 7))
        if seq == llmTick and seq > llmLastReply and eventSeq > 0 and eventSeq <= llmSeq and bot >= 0 and bot < GetBJMaxPlayers() and TimerGetElapsed(llmClock) <= S2R(LLMField(incoming, 3)) then
            if GetPlayerController(Player(bot)) == MAP_CONTROL_COMPUTER and text != "" and (channel == "all" or (channel == "team" and recipient >= 0 and recipient < GetBJMaxPlayers() and recipient != bot and IsPlayerAlly(Player(bot), Player(recipient)) and IsPlayerAlly(Player(recipient), Player(bot)))) then
                set llmLastVisible = 0
                if channel == "all" or (IsPlayerAlly(Player(bot), Player(llmHuman)) and IsPlayerAlly(Player(llmHuman), Player(bot))) then
                    set chatMode = 0
                    if channel == "team" then
                        set chatMode = 1
                    endif
                    // The native renders author, player color and localized
                    // channel label. It does not filter viewers, so retain
                    // the explicit alliance check above before calling it.
                    call BlzDisplayChatMessage(Player(bot), chatMode, text)
                    call LLMJournal(Player(bot), channel, text)
                    set llmLastVisible = 1
                endif
                set llmLastReply = seq
            endif
        endif
    endif
    call LLMSampleStep()
    set first = llmSeq - 255
    if first < 1 then
        set first = 1
    endif
    // Keep a compact overlapping tail and pin older important events without
    // rewriting the whole 256-event ring on every half-second heartbeat.
    set importantFrom = llmSeq - 63
    set i = llmSeq - 64
    loop
        exitwhen i < first or retained >= 32
        if LLMExportImportant(llmRecordKinds[ModuloInteger(i, 256)]) then
            set importantFrom = i
            set retained = retained + 1
        endif
        set i = i - 1
    endloop
    call PreloadGenClear()
    call PreloadGenStart()
    call Preload("AMAI1|" + llmSession + "|0|" + R2S(TimerGetElapsed(llmClock)) + "|tick|-1|" + I2S(llmHuman) + "|" + I2S(llmTick) + "|roster-v4|0|-1|-1||" + I2S(llmLastReply) + "," + I2S(llmLastVisible) + "," + BlzGetLocale())
    // Roster snapshots live outside the 256-event history, so a bridge can
    // reconnect at any point in the match without losing bot identities.
    set i = 0
    loop
        exitwhen i >= GetBJMaxPlayers()
        if GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then
            call Preload("AMAI1|" + llmSession + "|0|" + R2S(TimerGetElapsed(llmClock)) + "|bot|" + I2S(i) + "|" + I2S(llmHuman) + "|" + I2S(GetHandleId(GetPlayerRace(Player(i)))) + "||0|" + I2S(i) + "|-1|" + LLMEncode(GetPlayerName(Player(i))) + "|" + LLMAllies(i))
        endif
        set i = i + 1
    endloop
    set i = first
    loop
        exitwhen i > llmSeq
        if i >= llmSeq - 63 or (i >= importantFrom and LLMExportImportant(llmRecordKinds[ModuloInteger(i, 256)])) then
            call Preload(llmRecords[ModuloInteger(i, 256)])
        endif
        set i = i + 1
    endloop
    call PreloadGenEnd("AMAI-LLM\\events.pld")
endfunction

function LLMSetEnabled takes boolean enabled returns nothing
    local integer i = 0
    local integer humans = 0
    loop
        exitwhen i >= GetBJMaxPlayers()
        if GetPlayerController(Player(i)) == MAP_CONTROL_USER and GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then
            set humans = humans + 1
            set llmHuman = i
        endif
        set i = i + 1
    endloop
    if humans != 1 or llmHuman != GetPlayerId(GetLocalPlayer()) then
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10, "AMAI LLM: local single-human matches only.")
        return
    endif
    if enabled and not llmActive then
        set llmSession = I2S(GetRandomInt(100000, 999999)) + I2S(GetRandomInt(100000, 999999))
        set llmSeq = 0
        set llmTick = 0
        set llmLastReply = 0
        set llmLastVisible = 0
        set llmInputChannel = "auto"
        call LLMResetTelemetry()
        set llmActive = true
        call LLMInputStart()
        call LLMRecord("hello", -1, 0, "", 0, llmHuman, -1, "local-melee", GetPlayerName(Player(llmHuman)))
        set i = 0
        loop
            exitwhen i >= GetBJMaxPlayers()
            if GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then
                call LLMRecord("bot", i, GetHandleId(GetPlayerRace(Player(i))), "", 0, i, -1, GetPlayerName(Player(i)), LLMAllies(i))
                call FlushStoredMission(llmActionCache, I2S(i))
                set llmActionId[i] = 0
                set llmActionStatus[i] = 0
                call CommandAI(Player(i), 94, 1)
            endif
            set i = i + 1
        endloop
        call TimerStart(llmPoll, 0.5, true, function LLMPoll)
        call DisplayTimedTextToPlayer(Player(llmHuman), 0, 0, 10, "AMAI LLM: ON. Start the bridge; type a message to talk.")
    elseif not enabled and llmActive then
        call LLMRecord("off", -1, 0, "", 0, llmHuman, -1, "", "")
        call LLMPoll()
        set llmActive = false
        call PauseTimer(llmInputTimer)
        call LLMInputCancel()
        call PauseTimer(llmPoll)
        set i = 0
        loop
            exitwhen i >= GetBJMaxPlayers()
            if GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                call CommandAI(Player(i), 94, 0)
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(Player(llmHuman), 0, 0, 10, "AMAI LLM: OFF.")
    endif
endfunction

function LLMProcessHumanText takes string text, boolean renderLocal returns nothing
    local string input = llmInputChannel
    local string source = "bridge-mode"
    local string nativeChannel = "unknown"
    local string shown = text
    local integer mode = 0
    if GetPlayerId(GetTriggerPlayer()) != llmHuman then
        return
    endif
    if llmInputChoice != "" then
        set input = llmInputChoice
        set source = "hotkey"
    endif
    if renderLocal then
        set source = "local-composer"
        if input != "team" then
            set input = "all"
        endif
        if StringCase(SubString(text, 0, 5), false) == "@all " then
            set input = "all"
            set shown = SubString(text, 5, StringLength(text))
        elseif StringCase(SubString(text, 0, 6), false) == "@team " then
            set input = "team"
            set shown = SubString(text, 6, StringLength(text))
        endif
        set nativeChannel = input
    endif
    if text == "-llm on" then
        call LLMSetEnabled(true)
    elseif text == "-llm off" then
        call LLMSetEnabled(false)
    elseif text == "-llm team" or text == "-llm all" or text == "-llm auto" then
        set llmInputChannel = SubString(text, 5, StringLength(text))
        call DisplayTimedTextToPlayer(Player(llmHuman), 0, 0, 10, "AMAI LLM bridge route: " + llmInputChannel)
    elseif llmActive and renderLocal and SubString(text, 0, 1) == "-" then
        // These handlers normally read a native chat event. Preserve their
        // text and triggering player when the input came from our edit box.
        set llmForwardedChat = text
        if SubString(text, 0, 5) == "-zoom" then
            call ExecuteFunc("ZoomSet")
        else
            call ExecuteFunc("Commander")
        endif
        set llmForwardedChat = ""
    elseif llmActive and text != "" and SubString(text, 0, 1) != "-" then
        if renderLocal then
            if input == "team" then
                set mode = 1
            endif
            call BlzDisplayChatMessage(Player(llmHuman), mode, shown)
            call LLMJournal(Player(llmHuman), input, text)
            set llmLastComposerText = text
            set llmLastComposerAt = TimerGetElapsed(llmClock)
        else
            call LLMJournal(Player(llmHuman), "unknown", text)
        endif
        call LLMRecord("chat", -1, 0, "", 0, llmHuman, -1, SubString(text, 0, 450), "input=" + input + ";native=" + nativeChannel + ";route-source=" + source)
    endif
    if GetPlayerId(GetTriggerPlayer()) == llmHuman then
        call LLMInputFinish()
    endif
endfunction

function LLMOnChat takes nothing returns nothing
    local string text = GetEventPlayerChatString()
    if text == llmLastComposerText and TimerGetElapsed(llmClock) - llmLastComposerAt < 0.25 then
        return
    endif
    call LLMProcessHumanText(text, false)
endfunction

function LLMOnComposerEnter takes nothing returns nothing
    if not llmActive or not llmComposerActive or BlzGetTriggerFrame() != llmInputBox then
        return
    endif
    call LLMProcessHumanText(BlzGetTriggerFrameText(), true)
    if llmActive then
        call TimerStart(llmInputPresentationTimer, 0.0, false, function LLMInputCloseNative)
    endif
endfunction

function LLMOnHero takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local unit killer = GetKillingUnit()
    local integer owner = GetPlayerId(GetOwningPlayer(u))
    local integer k = -1
    local integer i = 0
    local string kind = "death"
    if not llmActive or not IsUnitType(u, UNIT_TYPE_HERO) then
        set u = null
        set killer = null
        return
    endif
    if killer != null then
        set k = GetPlayerId(GetOwningPlayer(killer))
    endif
    if GetTriggerEventId() == EVENT_PLAYER_HERO_REVIVE_FINISH then
        set kind = "revive"
    endif
    loop
        exitwhen i >= GetBJMaxPlayers()
        if GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then
            if owner == i or (IsUnitVisible(u, Player(i)) and not IsUnitInvisible(u, Player(i)) and not IsUnitHidden(u)) then
                call LLMRecord(kind, i, GetUnitTypeId(u), GetUnitName(u), GetHeroLevel(u), owner, k, GetHeroProperName(u), "unit=" + I2S(GetHandleId(u)) + ";x=" + R2S(GetUnitX(u)) + ";y=" + R2S(GetUnitY(u)))
            endif
        endif
        set i = i + 1
    endloop
    set u = null
    set killer = null
endfunction

function LLMAutoStart takes nothing returns nothing
    call DestroyTimer(GetExpiredTimer())
    call LLMSetEnabled(true)
endfunction

function LLMStartAfterMelee takes nothing returns nothing
    call TimerStart(CreateTimer(), 4.0, false, function LLMAutoStart)
endfunction

function LLMInit takes nothing returns nothing
    local trigger chat = CreateTrigger()
    local trigger keys = CreateTrigger()
    local trigger hero = CreateTrigger()
    local trigger telemetry = CreateTrigger()
    local integer i = 0
    set llmClock = CreateTimer()
    set llmPoll = CreateTimer()
    set llmInputTimer = CreateTimer()
    set llmInputPresentationTimer = CreateTimer()
    set llmInputSubmitTrigger = CreateTrigger()
    call TriggerAddAction(llmInputSubmitTrigger, function LLMOnComposerEnter)
    set llmCache = InitHashtable()
    set llmForceCache = InitHashtable()
    call TimerStart(llmClock, 86400, false, null)
    loop
        exitwhen i >= GetBJMaxPlayers()
        call TriggerRegisterPlayerChatEvent(chat, Player(i), "", false)
        call BlzTriggerRegisterPlayerKeyEvent(keys, Player(i), OSKEY_RETURN, 0, true)
        call BlzTriggerRegisterPlayerKeyEvent(keys, Player(i), OSKEY_RETURN, 1, true)
        call BlzTriggerRegisterPlayerKeyEvent(keys, Player(i), OSKEY_RETURN, 2, true)
        call BlzTriggerRegisterPlayerKeyEvent(keys, Player(i), OSKEY_RETURN, 3, true)
        call BlzTriggerRegisterPlayerKeyEvent(keys, Player(i), OSKEY_ESCAPE, 0, true)
        call TriggerRegisterPlayerUnitEvent(hero, Player(i), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(hero, Player(i), EVENT_PLAYER_HERO_REVIVE_FINISH, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_CONSTRUCT_START, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_CONSTRUCT_FINISH, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_CONSTRUCT_CANCEL, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_UPGRADE_START, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_UPGRADE_FINISH, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_UPGRADE_CANCEL, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_RESEARCH_FINISH, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_HERO_LEVEL, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_HERO_SKILL, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_PICKUP_ITEM, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_DROP_ITEM, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_USE_ITEM, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_SELL_ITEM, null)
        call TriggerRegisterPlayerUnitEvent(telemetry, Player(i), EVENT_PLAYER_UNIT_PAWN_ITEM, null)
        set i = i + 1
    endloop
    call TriggerAddAction(chat, function LLMOnChat)
    call TriggerAddAction(keys, function LLMOnChatKey)
    call TriggerRegisterPlayerUnitEvent(telemetry, Player(PLAYER_NEUTRAL_PASSIVE), EVENT_PLAYER_UNIT_SELL_ITEM, null)
    call TriggerAddAction(hero, function LLMOnHero)
    call TriggerAddAction(telemetry, function LLMOnTelemetry)
    set chat = null
    set keys = null
    set hero = null
    set telemetry = null
endfunction
